{% comment %}
  PayBro / Prepaid Perks - Theme App Extension
  App Embed Block for Broomies Bakery
{% endcomment %}

{% if block.settings.enabled %}
  <script src="{{ 'prepaid-offer.js' | asset_url }}" defer="defer"></script>

  <div id="paybro-config" 
    data-app-url="https://paybro-eta.vercel.app"
    data-discount-percent="10"
    data-min-order="499"
    data-shop-domain="{{ shop.permanent_domain }}"
    style="display: none;">
  </div>
{% endif %}

{% schema %}
{
  "name": "PayBro Prepaid Offer",
  "target": "body",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enable Prepaid Offer Banner",
      "default": true
    }
  ]
}
{% endschema %}
